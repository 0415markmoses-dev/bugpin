{
  "name": "bugpin",
  "description": "Self-hosted visual bug reporting tool",
  "version": "1.2.1",
  "packageManager": "bun@1.4.0",
  "license": "AGPL-3.0-only",
  "private": false,
  "type": "module",
  "workspaces": [
    "src/server",
    "src/admin",
    "src/widget"
  ],
  "scripts": {
    "dev": "npm run dev:server & npm run dev:admin",
    "dev:server": "node --watch src/server/index.ts",
    "dev:admin": "npm --prefix src/admin run dev",
    "dev:widget": "npm --prefix src/widget run build:watch",
    "build": "npm run build:server && npm run build:admin && npm run build:widget",
    "build:server": "npx tsc --project src/server/tsconfig.json",
    "build:admin": "npm --prefix src/admin run build",
    "build:widget": "npm --prefix src/widget run build",
    "start": "node src/server/index.ts",
    "typecheck": "npm run typecheck:server && npm run typecheck:admin && npm run typecheck:widget",
    "typecheck:server": "npx tsc --noEmit --project src/server/tsconfig.json",
    "typecheck:admin": "npm --prefix src/admin run typecheck",
    "typecheck:widget": "npm --prefix src/widget run typecheck",
    "test": "npx vitest run tests/server tests/shared",
    "test:server": "npx vitest run tests/server tests/shared",
    "test:admin": "npm --prefix src/admin run test",
    "test:widget": "npm --prefix src/widget run test",
    "migrate": "node src/server/database/migrations/index.ts",
    "reset-password": "node src/server/scripts/reset-password.ts",
    "knip": "knip",
    "format": "prettier --ignore-path .prettierignore --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --ignore-path .prettierignore --check \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "vercel-build": "npm run build:admin"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^26.2.0",
    "knip": "^6.32.2",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "fast-xml-builder": "^1.2.0",
    "fast-xml-parser": "^5.7.2",
    "tar": "^7.5.13",
    "dompurify": "^3.4.2",
    "smol-toml": "^1.6.1",
    "brace-expansion": "^2.0.3",
    "follow-redirects": "^1.16.0",
    "markdown-it": "^14.1.1",
    "postcss": "^8.5.13",
    "rollup": "^4.60.2",
    "minimatch": "^9.0.9",
    "picomatch": "^4.0.4"
  }
}
